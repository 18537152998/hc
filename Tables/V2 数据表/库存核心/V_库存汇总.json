    "CreateViewSql": "SELECT\r\n  公司产品ID,\r\n  仓库ID,\r\n  IFNULL(SUM(入库数量),0) AS 入库合计,\r\n  IFNULL(SUM(出库数量),0) AS 出库合计,\r\n  IFNULL(SUM(入库数量),0) - IFNULL(SUM(出库数量),0) AS 当前库存\r\nFROM 库存流水表\r\nWHERE IFNULL(是否有效,1)=1\r\nGROUP BY 公司产品ID, 仓库ID"
