  "Values": {
    "1,1": "包装人员绩效考核 汇总",
    "1,51": "导出",
    "1,73": "%CurrentUser.UserName%",
    "2,2": "*请依次选择人员评分",
    "5,1": "姓名",
    "5,14": "所在部门",
    "5,18": "包装部",
    "6,1": "考核项目",
    "6,8": "问题反馈项考核项目",
    "6,30": "根据反馈扣分",
    "6,75": 1,
    "6,76": 2,
    "6,77": 3.0,
    "6,78": 4.0,
    "6,79": 5.0,
    "6,80": 6.0,
    "6,81": 7.0,
    "6,82": 8.0,
    "6,83": 9.0,
    "6,84": 10.0,
    "6,85": 11.0,
    "6,86": 12.0,
    "6,87": 13.0,
    "7,1": "包装质量",
    "7,6": "一类问题\r\n★★★\r\n（30分）",
    "7,10": "1、跨账户贴错标签/放错售后卡；",
    "8,10": "2、产品涉及侵权logo/卡片未剔除（责任在包装的）；",
    "9,10": "3、包错货（本账户/跨账户）；",
    "10,10": "4、产品未贴内标签/标签破损/模糊无法扫码；",
    "11,6": "二类问题\r\n★★\r\n（10-30分）",
    "11,10": "1、抽检产品试机不工作（针对明确需试机产品）；",
    "12,10": "2、配件/资料（售后卡，说明书等）/插头漏放或错放；",
    "13,10": "3、包装有明显安全隐患（例如刀头未处理容易导致划伤）；",
    "14,10": "4、内箱包装破烂疑似二手货（已跟业务确认且无法换箱的除外）；",
    "15,10": "5、机器本身有明显划痕/内箱有杂物（如头发/垃圾）/食品类产品有污渍；",
    "16,10": "6、CE/UFCA/made in china/透明计划/使用提示标贴等标签未贴；",
    "17,10": "7、标签破损/模糊，影响扫码；",
    "18,10": "8、外箱裁切痕迹明显，影响发货/入库。",
    "19,6": "三类问题\r\n★\r\n（0-10分）",
    "19,10": "1、内箱胶带多打/乱打；",
    "20,10": "2、标签留白不足3mm/条码有断点；",
    "21,10": "3、内外箱过度填充/内箱碎板填充/填充不足有晃动；包装规格尺寸变化大，泡重大",
    "22,10": "4、产品品牌logo标贴/提示标贴等贴歪贴反；",
    "23,10": "5、厂家自带纸箱含logo/商标未遮盖，中文标签/说明书未取出。",
    "24,1": "其他反馈",
    "24,10": "如工作交接情况、工作配合、工作沟通效果、建议意见或者表扬批评等。"
  },
  "Formulas": {
