  "Values": {
    "1,1": "物流助理 月度工作运营/执行反馈反馈汇总",
    "1,49": "导出",
    "1,61": "%CurrentUser.账户%",
    "2,1": "*请依次选择人员评分",
    "3,61": "%CurrentUser.UserName%",
    "5,1": "姓名",
    "5,14": "所在部门",
    "5,18": "物流部",
    "6,1": "问题反馈项考核项目",
    "6,14": "具体内容",
    "6,36": "评分此项文字描述，不打分（此部分运营和执行只进行文字描述，不打分，没有请写无））",
    "7,63": 1,
    "7,64": 2,
    "7,65": 3.0,
    "7,66": 4.0,
    "7,67": 5.0,
    "7,68": 6.0,
    "7,69": 7.0,
    "7,70": 8.0,
    "7,71": 9.0,
    "7,72": 10.0,
    "7,73": 11.0,
    "7,74": 12.0,
    "7,75": 13.0,
    "7,76": 14.0,
    "7,77": 15.0,
    "7,78": 16.0,
    "8,1": "自发、海运发货情况反馈",
    "8,14": "云协作自发运费查询系统价格是否准确无误，是否及时更新最新价表；\r\n自发货问题集锦表是否在每月25日前跟进回复。",
    "9,1": "制单情况反馈",
    "9,14": "制单是否选错账号；是否根据客户收件地址查询偏远、私人住址等杂费，选择性价比更优渠道，对偏远的把控和建议；\r\n需要打印的资料是否及时，是否准确。",
    "10,1": "渠道管理/反馈",
    "10,14": "新的渠道是否及时反馈申报细节、投递情况、时效；\r\n有新的更优惠的渠道后是否第一时间发通知同步给运营。",
    "11,1": "货代账单核对",
    "11,14": "每月配合货代账单核对，补充记录，核对金额/发货信息，核对发现异常并及时更新无误，于每月10号前完成，不及时或账单异常数据未发现反馈；\r\n每月总结账单问题并反馈",
    "12,1": "物流追踪货件追踪及货代渠道突发情况处理反馈",
    "12,14": "时效追踪，时效更新，两周1次，群里通知；\r\n追踪前三个月上架情况，对丢件进行索赔；\r\n产品确认：对于特殊产品、地址、重量等，配合执行询问货代并提供合适渠道；\r\n异常件问题是否追踪跟进反馈。",
    "13,1": "其他反馈和建议",
    "13,14": "如工作连贯性、主动性、交接情况、工作沟通效果、建议意见或者表扬批评等"
  },
  "Formulas": {
