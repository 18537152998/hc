  "Values": {
    "2,1": "开票通知",
    "4,1": "    感谢您对我司工作的支持与帮助！以下的开票资料系我司根据您所申报的采购信息所制作，请您结合实际采购情况核实确认相关开票信息后，通知销售单位按照实际采购信息开具发票。",
    "8,1": "购货单位名称：",
    "9,1": "纳税人识别号：",
    "10,1": "开票地址：",
    "11,1": "请核对开票抬头！",
    "12,1": "销售方：",
    "13,1": "合同号码：",
    "14,1": "请结合您的实际采购情况确认，是否按以下信息开票：",
    "15,14": "开票数量",
    "15,22": "税点",
    "15,26": "价税合计",
    "15,31": "备注",
    "18,1": "合计",
    "19,1": "注意：请在增值税发票的右下角备注栏处备注：",
    "20,1": "同时备注送货单上的送货时间，如果送货时间不一致，需要分开开具发票"
  },
  "Formulas": {
    "18,26": "SUM(AA17)",
    "16,22": "IF(AJ17=\"\",AK17,AJ17)"
  },
